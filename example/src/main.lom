# Window
__C InitWindow(w: i32, h: i32, title: ref u8);
__C CloseWindow();
__C WindowShouldClose() bool;

# Drawing
__C BeginDrawing();
__C EndDrawing();
__C ClearBackground(color: u32);
__C DrawLine(x1: i32, y1: i32, x2: i32, y2: i32, color: u32);

pub main: () i32 {
    __C.InitWindow(1280, 720, "Cube");
    bg_color: u32 = cast<u32>(0) - 1;

    while not __C.WindowShouldClose() {
        __C.BeginDrawing();
        __C.ClearBackground( bg_color );
        __C.EndDrawing();
    }

    __C.CloseWindow();
    return 0;
}
